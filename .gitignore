# Opencode Portable - runtime locale, non committare
data/
dist*/
src/**/bin/
src/**/obj/
src/**/payload/
config/*
!config/opencode.example.json
bin/*
!bin/.gitkeep
*.log
.env
.env.*
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
*.asc
*.gpg
*.crt
*.cer
*.der
id_rsa*
id_ed25519*
id_ecdsa*
*.ppk
secrets.json
*credentials*.json
*.token
# Release-asset hashes live in dist/ (gitignored); the committed pin file is
# the exception (see UPSTREAM_VERSION.sha256).
*.sha256
!UPSTREAM_VERSION.sha256
*.cdx.json
.DS_Store
Thumbs.db
Desktop.ini
.vs/
.vscode/
*.tmp
*.bak
*~
